# FindHub Tracker Backend Configuration
# Copy this file to .env and fill in your values

# Server settings
HOST=0.0.0.0
PORT=8000

# Google Find Hub authentication
# Run: python main.py --authenticate
# This will open Chrome for Google login and save credentials
AUTH_DIR=./auth

# Refresh interval in seconds (how often to check tracker locations)
REFRESH_INTERVAL=300

# Tracker names to monitor (comma-separated, leave empty for all)
# Example: My Keys,My Backpack,Car Tracker
TRACKER_FILTER=
